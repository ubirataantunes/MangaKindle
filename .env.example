# Hash argon2 da senha do app. NÃO coloque a senha em texto puro aqui.
# Gere com: docker compose run --rm --no-deps mangakindle python password_hash.py
# O hash tem vários "$". Coloque o valor entre aspas simples, como abaixo. (Alternativa sem aspas:
# trocar cada "$" por "$$". Nunca misture as duas formas.) Veja o README.
APP_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$troque$pelo-hash-gerado'
# Texto aleatório e longo, usado para assinar o cookie de login.
SESSION_SECRET=troque-por-um-texto-aleatorio-longo

# Cookie de sessão só por HTTPS (padrão: true). O docker-compose.yml desliga isso para o uso local em http://localhost;
# o docker-compose.prod.yml liga de novo. Só use "false" no desenvolvimento local.
SECURE_COOKIES=true

# IPs de proxies confiáveis (separados por vírgula). Só eles podem informar o IP real do visitante pelo CF-Connecting-IP.
# Vazio = ninguém é confiável. O docker-compose.prod.yml já define o IP do cloudflared.
TRUSTED_PROXY_IPS=

# Token do Cloudflare Tunnel (só no deploy com docker-compose.prod.yml). Pegue no painel Zero Trust ao criar o túnel.
TUNNEL_TOKEN=

# E-mail que envia os arquivos. Ele precisa estar na lista de e-mails aprovados do Kindle
# (Amazon > Conteúdo e dispositivos > Preferências > Configurações de documentos pessoais).
# No Gmail, use uma "senha de app", não a senha normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# Endereço "Enviar para Kindle" do seu aparelho.
KINDLE_EMAIL=seu-nome_xyz@kindle.com

# Perfil do KCC para o seu modelo. Ex.: KPW5 (Paperwhite 5/Signature), KPW6 (Paperwhite 2024),
# KO (Oasis 2/3), KS (Scribe), KCS (Colorsoft), K11 (Kindle básico 11ª geração).
KINDLE_PROFILE=KPW5

# Tamanho máximo de cada EPUB enviado. 17 MB cabe no limite de 25 MB do Gmail depois da codificação do e-mail.
MAX_ATTACHMENT_MEGABYTES=17

# Máximo de e-mails em 24 horas. O Gmail bloqueia o envio por um dia ao passar de 500.
# Ao chegar no limite, o envio para e pode ser retomado depois com "Tentar de novo".
MAX_EMAILS_PER_DAY=500
