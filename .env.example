# ---------- Envio para o Kindle (obrigatório) ----------

# E-mail que envia os arquivos. No Gmail, use uma "senha de app", não a senha normal da conta.
# Veja no README como gerar a senha de app e como liberar esse e-mail na Amazon.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# Endereço "Enviar para Kindle" do seu aparelho.
KINDLE_EMAIL=seu-nome_xyz@kindle.com

# Perfil do KCC para o seu modelo (tabela no README). Ex.: K810 (Kindle 8ª/10ª geração),
# K11 (Kindle 11ª geração), KPW5 (Paperwhite 5/Signature), KPW6 (Paperwhite 2024).
KINDLE_PROFILE=KPW5

# Texto aleatório e longo. Assina o cookie do navegador e protege os formulários.
SESSION_SECRET=troque-por-um-texto-aleatorio-longo

# ---------- Senha do app (opcional) ----------

# false = o app abre direto, sem senha (bom para rodar só no seu PC).
# true  = pede senha. Aí preencha APP_PASSWORD_HASH (veja "Ligar a senha" no README).
LOGIN_ENABLED=false
# Use aspas simples: o hash tem vários "$".
APP_PASSWORD_HASH=

# ---------- Ajustes (opcional) ----------

# Tamanho máximo de cada EPUB enviado. 17 MB cabe no limite de 25 MB do Gmail depois da codificação do e-mail.
MAX_ATTACHMENT_MEGABYTES=17

# Máximo de e-mails em 24 horas. O Gmail bloqueia o envio por um dia ao passar de 500.
# Ao chegar no limite, o envio para e pode ser retomado depois com "Tentar de novo".
MAX_EMAILS_PER_DAY=500
